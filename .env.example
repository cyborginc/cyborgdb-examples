# CyborgDB Configuration
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed

# Get your API key from https://cyborgdb.co
CYBORGDB_API_KEY=your_api_key_here

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
POSTGRES_CONNECTION_STRING="host=localhost port=5432 dbname=dbname user=user password=''"

# Alternative: Redis connection string (uncomment if using Redis)
# REDIS_CONNECTION_STRING=="host:localhost,port:6379,db:0"
